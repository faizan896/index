# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and the browser-safe key from Supabase → Project Settings → API.
# New projects call it the "publishable" key (sb_publishable_…). Older projects
# call it the "anon" key; either works here. Never put the secret/service-role
# key in any NEXT_PUBLIC_ variable — Index does not need it at all.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public origin of the app, used to build sign-in redirect URLs.
# Local: http://localhost:3000  ·  Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Anthropic (optional) ────────────────────────────────────────────────────
# Server-only. When unset, links are still saved and fetched, but they arrive
# as Unsorted and you organize them by hand.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5-5. For the lowest cost,
# claude-haiku-5-5 categorizes well at a fraction of the price.
ANTHROPIC_MODEL=

# ─── Access (optional) ───────────────────────────────────────────────────────
# Comma-separated email addresses allowed to sign in. Leave empty to allow any
# account your Supabase project accepts. Recommended for a personal deployment.
INDEX_ALLOWED_EMAILS=
