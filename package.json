{
  "name": "index-library",
  "version": "0.1.0",
  "private": true,
  "description": "Index — a quiet, private library for everything worth reading.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
